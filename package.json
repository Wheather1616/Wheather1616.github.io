{
  "name": "william-heather-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio website for GitHub Pages",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint \"assets/**/*.js\"",
    "lint:css": "stylelint \"assets/**/*.css\"",
    "lint:html": "html-validate \"**/*.html\"",
    "check:syntax": "node --check assets/site.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "html-validate": "^11.16.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended": "^18.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
